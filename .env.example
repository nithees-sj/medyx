# Copy to .env and fill in. .env is gitignored.

# ── Auth ──────────────────────────────────────────────────────────────
# Google OAuth "Web application" client ID (see README → Google Cloud setup).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Long random string, e.g. `python3 -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
# Comma-separated Google emails that become admins on first sign-in.
ADMIN_EMAILS=you@gmail.com

# ── AI (Google Gemini) ────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Requests per minute your key allows (free tier = 5). Raise on a paid key.
AI_REQUESTS_PER_MINUTE=5

# ── Data ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://healththread:healththread@localhost:5432/healththread
TEST_DATABASE_URL=postgresql+psycopg://healththread:healththread@localhost:5432/healththread_test
FHIR_BASE_URL=http://localhost:8080/fhir
STORAGE_DIR=./storage

# ── App ───────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
# Where the Next.js server proxies /api/* (rewrites).
BACKEND_URL=http://localhost:8000
DEMO_MODE=true
DEMO_CACHE=true
DEFAULT_TIMEZONE=Asia/Kolkata
# Timezone the browser formats dates in (keep in sync with DEFAULT_TIMEZONE).
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
